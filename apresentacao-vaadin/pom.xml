<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.edu.cesar.filafood</groupId>
    <artifactId>filafood-pai</artifactId>
    <version>1.0.0</version>
    <relativePath>../pai/pom.xml</relativePath>
  </parent>

  <artifactId>apresentacao-vaadin</artifactId>
  <packaging>jar</packaging>
  <name>FilaFood: apresentação Vaadin</name>

  <properties>
    <spring-boot.run.skip>false</spring-boot.run.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>vaadin-spring-boot-starter</artifactId>
    </dependency>
    <!-- Modo de desenvolvimento do Vaadin (frontend servido pelo dev server), exigido só fora de
         produção; o spring-boot-maven-plugin o deixa fora do jar executável. -->
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>vaadin-dev</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>br.edu.cesar.filafood</groupId>
      <artifactId>aplicacao</artifactId>
    </dependency>
    <!-- A infraestrutura entra só em runtime: a apresentação compila contra as portas da aplicação
         e do domínio, nunca contra as classes JPA. -->
    <dependency>
      <groupId>br.edu.cesar.filafood</groupId>
      <artifactId>infraestrutura</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Fonte única do visual: o CSS dos protótipos é servido como /estilo.css, sem cópia. -->
      <resource>
        <directory>${project.basedir}/../docs/prototipos</directory>
        <includes>
          <include>estilo.css</include>
        </includes>
        <targetPath>META-INF/resources</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
