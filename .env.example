# Copie para .env (não versionado) e ajuste se quiser. O docker compose lê este arquivo
# automaticamente; o app lê DB_PASSWORD diretamente do ambiente (ver README).
DB_NAME=filafood
DB_USER=filafood
DB_PASSWORD=troque-esta-senha
# Porta do host para o Postgres do compose; troque se a 5432 já tiver um Postgres instalado no Windows.
DB_PORT=5432
